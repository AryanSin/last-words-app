# Server Environment Variables Example
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/last_words?schema=public"

# Redis Connection (Rate Limiting, Refresh Tokens, BullMQ Queues)
# Use either REDIS_URL (e.g. Upstash / Render: "rediss://default:password@host:port") OR REDIS_HOST + REDIS_PORT (+ optional REDIS_PASSWORD)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Security
JWT_SECRET=super_secret_jwt_key_last_words_dev_2026_change_in_prod

# Message Encryption (AES-256-GCM field encryption for DB protection)
MESSAGE_ENCRYPTION_SECRET=super_secret_message_encryption_key_dev_2026_change_in_prod

# Google OAuth (Optional in dev)
GOOGLE_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_WEB_CLIENT_ID=

# WhatsApp Provider ("dev", "twilio", or "meta")
WHATSAPP_PROVIDER=dev

# Twilio WhatsApp Config (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Meta WhatsApp Cloud API Config (Optional)
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# Email SMTP Config (Leave blank for automatic Ethereal test inbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Last Words <noreply@lastwords.app>"
