# Expo Public API URL
# - iOS Simulator / Web: http://localhost:3000
# - Android Emulator: http://10.0.2.2:3000
# - Physical Mobile Device on same Wi-Fi: http://<YOUR_PC_IP>:3000 (e.g. http://192.168.1.15:3000)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google OAuth Client IDs (Expo Public)
# 1. Web Client ID (Application type: 'Web application' in Google Cloud Console)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=840121535735-1thurhpb5ie0nlfclljnn84jo1snsp1s.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=840121535735-1thurhpb5ie0nlfclljnn84jo1snsp1s.apps.googleusercontent.com

# 2. Native Mobile Client IDs
# (Google strictly forbids Web client IDs with mobile custom scheme URIs like mobile:// or com.lastwords.app:/)
# In Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth client ID:
# - Android: Choose 'Android', package: com.lastwords.app, plus your debug SHA-1 fingerprint
# - iOS: Choose 'iOS', bundle ID: com.lastwords.app
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
