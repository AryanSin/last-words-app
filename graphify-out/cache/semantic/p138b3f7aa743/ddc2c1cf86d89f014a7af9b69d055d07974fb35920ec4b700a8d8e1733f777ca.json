{"nodes": [{"id": "agent_skills_impeccable_reference_mode_persuade_doc", "label": "Persuade and Experience Mode Rules", "file_type": "document", "source_file": ".agent/skills/impeccable/reference/mode-persuade.md", "source_location": "L1-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_impeccable_reference_mode_persuade_persuade_opening", "label": "Persuade Opening Requirements", "file_type": "rationale", "rationale": "The opening must make the offer intelligible and desirable, expose a working primary action (never a decorative link), and demonstrate something only this product can prove.", "source_file": ".agent/skills/impeccable/reference/mode-persuade.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_impeccable_reference_mode_persuade_carrier_not_picture", "label": "World as Carrier, Not Picture", "file_type": "rationale", "rationale": "The world may be the carrier of the page with real material coverage while working parts stay functional; a painted poster without working parts or a generic template with a sticker both erase the direction.", "source_file": ".agent/skills/impeccable/reference/mode-persuade.md", "source_location": "L13-L15", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_impeccable_reference_mode_persuade_single_object_scale", "label": "Single Object Form Fidelity", "file_type": "rationale", "rationale": "When the world is an object, render that one object once at one scale and one point of view, preserving its real physical form without extra copies or impossible folds.", "source_file": ".agent/skills/impeccable/reference/mode-persuade.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agent_skills_impeccable_reference_mode_persuade_doc", "target": "agent_skills_impeccable_refer