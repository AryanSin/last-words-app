{
  "name": "last-words-app",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:server": "pnpm --filter server dev:server",
    "dev:worker": "pnpm --filter server dev:worker",
    "dev:combined": "pnpm --filter server dev:combined",
    "dev:mobile": "pnpm --filter mobile start",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "build": "pnpm --filter server build",
    "build:mobile:web": "pnpm --filter mobile build:web",
    "start:server": "pnpm --filter server start",
    "start:worker": "pnpm --filter server start:worker",
    "start:combined": "pnpm --filter server start:combined",
    "test": "pnpm --filter server test",
    "lint": "pnpm -r run lint"
  },
  "repository": {
    "type": "git",
    "url": "git@github-personal:AryanSin/last-words-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Last Words - Automated Inactivity Messaging & Switch",
  "devDependencies": {
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsconfig-paths": "^4.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma"
    ]
  }
}
