{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "paths": {
      "@shared/*": ["./packages/shared/src/*"],
      "@lastwords/shared/*": ["./packages/shared/src/*"]
    },

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}